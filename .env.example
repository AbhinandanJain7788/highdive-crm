# Supabase project: recruitment-crm (ap-south-1)
# Public URL and anon/publishable key — safe for client-side use.
NEXT_PUBLIC_SUPABASE_URL=https://xvcnhfkrjghjxyyftkkm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_l66mkOjA3mhM8o8QLlvxoA_htTOXqOa

# Server-only secret — bypasses RLS. Never expose to the client or commit the real value.
# Get it from Supabase dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backblaze B2 — read-only for the CRM. Recordings are uploaded by the Android app;
# the CRM only ever streams/plays them via b2_url, never writes.
B2_BUCKET=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Base URL the app iss served from (used for auth redirects, generated report links, etc).
APP_BASE_URL=http://localhost:3000

NODE_ENV=development
